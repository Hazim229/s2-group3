rules_version = '2';

// CampusEats · s2-group3
// Each member adds their feature's rule inside their own block below, by pull request.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers · owner 2419247 (Setup lead) ──
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin()  { return signedIn() && role() == 'admin'; }
    function isVendor() { return signedIn() && role() == 'vendor'; }
    // The vendor who owns a shop: vendors/{shopId}.ownerUid == their uid.
    // getAfter so a shop and its menu can be seeded in one batch.
    function ownsShop(shopId) {
      return isVendor()
        && getAfter(/databases/$(database)/documents/vendors/$(shopId)).data.ownerUid == request.auth.uid;
    }

    // ── Users and roles · owner 2419247 (Setup lead) ──
    // users/{uid}: { role: 'student' | 'vendor' | 'admin', ... }
    // A user may create their own doc as 'student'; only the admin changes role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'student';
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // ── Shops and menus · owner 2419247 (Setup lead) ──
    // Everyone reads. A vendor creates their shop with ownerUid = their own uid,
    // and after that only that owner (or the admin) can change it. ownerUid cannot be changed.
    match /vendors/{shopId} {
      allow read: if true;
      allow create: if isAdmin()
                    || (isVendor() && request.resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isVendor() && resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin();

      match /menu/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || ownsShop(shopId);
      }
    }

    // ── Feature · owner 2419247 ──

    // ── Feature · owner 2410509 ──

    // ── Feature · owner 2417219 ──

    // ── Feature · owner 2416443 ──

    // ── Feature · owner 2410687 ──
  }
}
